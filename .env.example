# ==============================================================================
# Environment Configuration Template: smb-ops
# Copy this file to .env and configure local values during development.
# In production, this file is rendered from Ansible Vault by homelab-ops.
# ==============================================================================

# Application Environment (prod, stage, dev)
APP_ENV=dev

# Service Port Bindings
SERVICE_HTTP_PORT=8080

# Persistent Data Storage Path
# Local Development: points to relative workspace
# Production: Injected by Ansible as /opt/homelab/prod/data/smb-ops
DATA_DIR=./data

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info


# Upstream Pre-Built Image Coordinates (GHCR / Container Registry)
BACKEND_IMAGE=ghcr.io/mnaatjes/smb-ops-api:latest
FRONTEND_IMAGE=ghcr.io/mnaatjes/smb-ops-ui:latest

# Service Secrets (Injected via Ansible Vault in production)
API_SECRET_KEY=dev_secret_key_change_in_production

